{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skill-grill-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "VOTE_RATE_LIMITER",
      "namespace_id": "7001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "COMMENT_RATE_LIMITER",
      "namespace_id": "7002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "7003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    }
  }
  // Set DATABASE_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, and WEB_ORIGIN
  // in apps/api/.dev.vars locally. For deployed Workers, use Wrangler secrets.
}
