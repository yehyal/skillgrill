{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skill-grill-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "vars": {
    "WEB_ORIGIN": "http://localhost:3000"
  },
  "ratelimits": [
    {
      "name": "VOTE_RATE_LIMITER",
      "namespace_id": "7001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "COMMENT_RATE_LIMITER",
      "namespace_id": "7002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "7003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    }
  }
  // Set DATABASE_URL, SUPABASE_URL, and SUPABASE_PUBLISHABLE_KEY in apps/api/.dev.vars locally.
  // For deployed Workers, use Wrangler secrets for DATABASE_URL and the Supabase credentials.
}
