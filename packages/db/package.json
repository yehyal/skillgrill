{
  "name": "@skill-grill/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./seed": {
      "types": "./src/seed.ts",
      "default": "./src/seed.ts"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate --config=drizzle.config.ts",
    "lint": "eslint src",
    "migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "seed": "tsx src/seed.ts",
    "studio": "drizzle-kit studio --config=drizzle.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@skill-grill/shared": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.0.0"
  }
}
